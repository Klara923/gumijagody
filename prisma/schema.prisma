datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum DocumentDirection {
  RECEIVABLE
  PAYABLE
}

enum DocumentSource {
  KSEF
  UPLOAD
  MANUAL
}

enum DocumentStage {
  BUFFER
  ACCEPTED
}

enum AttachmentKind {
  KSEF_XML
  SOURCE_FILE
}

enum ImportTrigger {
  MANUAL
  SCHEDULED
}

enum ImportStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum KsefInvoiceKind {
  COST
  SALES
}

model DocumentType {
  id String @id @default(cuid())

  name      String            @unique
  direction DocumentDirection

  isSystem Boolean @default(false)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(cuid())

  name     String
  parentId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  documents             Document[]
  defaultForContractors Contractor[]        @relation("ContractorDefaultCategory")
  keywordRules          CategoryKeywordRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, name])
  @@index([parentId])
}

model CategoryKeywordRule {
  id String @id @default(cuid())

  keyword String @unique

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  priority Int @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([priority])
}

model Contractor {
  id String @id @default(cuid())

  name String

  nip String? @unique @db.VarChar(10)

  street     String?
  postalCode String?
  city       String?
  country    String  @default("PL") @db.Char(2)

  bankAccount String?

  defaultCategoryId String?
  defaultCategory   Category? @relation("ContractorDefaultCategory", fields: [defaultCategoryId], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([defaultCategoryId])
}

model Document {
  id String @id @default(cuid())

  number String

  typeId String
  type   DocumentType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)

  issueDate DateTime  @db.Date
  dueDate   DateTime? @db.Date

  netAmount   Decimal @db.Decimal(14, 2)
  vatAmount   Decimal @db.Decimal(14, 2)
  grossAmount Decimal @db.Decimal(14, 2)
  currency    String  @default("PLN") @db.Char(3)

  paymentAccount String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  source     DocumentSource
  ksefNumber String?        @unique

  stage      DocumentStage @default(BUFFER)
  acceptedAt DateTime?

  attachments Attachment[]

  importRunId String?
  importRun   ImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([number, contractorId])
  @@index([stage, issueDate])
  @@index([stage, dueDate])
  @@index([contractorId])
  @@index([categoryId])
  @@index([typeId])
}

model Attachment {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  kind      AttachmentKind
  filename  String
  mimeType  String
  sizeBytes Int

  checksum String

  content Bytes

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([checksum])
}

model ImportRun {
  id String @id @default(cuid())

  trigger     ImportTrigger
  invoiceKind KsefInvoiceKind
  rangeFrom   DateTime        @db.Date
  rangeTo     DateTime        @db.Date

  status     ImportStatus @default(RUNNING)
  startedAt  DateTime     @default(now())
  finishedAt DateTime?

  importedCount  Int @default(0)
  duplicateCount Int @default(0)

  error String?

  documents Document[]

  @@index([startedAt])
}

model ScheduleSetting {
  id String @id @default("singleton")

  enabled Boolean @default(false)

  runTimes String[] @default([])
  timezone String   @default("Europe/Warsaw")

  lookbackDays Int               @default(7)
  invoiceKinds KsefInvoiceKind[] @default([COST, SALES])

  lastRunAt DateTime?

  updatedAt DateTime @updatedAt
}

model TablePreference {
  id String @id @default(cuid())

  view String @unique

  visibleColumns String[]

  updatedAt DateTime @updatedAt
}
