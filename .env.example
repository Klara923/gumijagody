APP_PORT="3000"

DATABASE_URL="postgresql://gumijagody:gumijagody@localhost:5433/gumijagody?schema=public"

# Lokalnie: mock (bez tokena). Na wdrożeniu: KSEF_CLIENT="http" + KSEF_NIP + KSEF_TOKEN.
# Diagnostyka auth: npm run ksef:spike
# Demo tnie import do 50 faktur (POST /invoices/query/metadata, 20 wywołań/h).
# POST /invoices/exports (paczka) nie jest zaimplementowany — duży wolumen, nie ten zakres.
KSEF_CLIENT="mock"

KSEF_API_BASE_URL="https://api-test.ksef.mf.gov.pl/v2"

KSEF_NIP=""

KSEF_TOKEN=""

CRON_SECRET=""
# Wspólny sekret dla POST /api/cron/ksef (Authorization: Bearer …).
# W docker-compose domyślnie: lokalny-sekret-dev
# Na Vercel ustaw CRON_SECRET w env — vercel.json woła /api/cron/ksef co minutę.

# Tryb jednego użytkownika (PDF §2). Puste = aplikacja otwarta.
# Ustaw na Vercel, żeby publiczny URL nie był edytowalny bez hasła.
APP_PASSWORD="gumijagoda"
# Opcjonalny sekret podpisu ciasteczka (min. 16 znaków). Bez niego używany jest APP_PASSWORD.
APP_SESSION_SECRET=""
