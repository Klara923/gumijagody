# Skopiuj do `.env` i uzupełnij. Plik `.env` jest w .gitignore i nie może trafić do repozytorium.

# --- Aplikacja ---
# Port aplikacji na hoście przy `docker compose up`. Zmień, jeśli 3000 jest zajęty.
APP_PORT="3000"

# --- Baza danych ---
# Z hosta port 5433, z wnętrza kontenera aplikacji host `db` i port 5432.
# 5433 zamiast domyślnego 5432, żeby nie kolidować z innym Postgresem uruchomionym lokalnie.
DATABASE_URL="postgresql://gumijagody:gumijagody@localhost:5433/gumijagody?schema=public"

# --- KSeF (środowisko testowe) ---
# `mock` - klient czyta faktury z fixtures, nie wymaga sieci ani tokena (pozwala uruchomić
#          projekt bez konta w KSeF)
# `http` - prawdziwa integracja ze środowiskiem testowym
KSEF_CLIENT="mock"

# Kanoniczna ścieżka z kontraktu OpenAPI to /v2 (bez /api).
KSEF_API_BASE_URL="https://api-test.ksef.mf.gov.pl/v2"

# NIP kontekstu, na który wygenerowano token (10 cyfr, dane fikcyjne - to środowisko testowe).
KSEF_NIP=""

# Token KSeF z uprawnieniem "przeglądanie faktur" (InvoiceRead).
# Generowany w Aplikacji Podatnika: https://ap-test.ksef.mf.gov.pl -> Tokeny -> Generuj token.
# Wyświetla się jednorazowo. Wyłącznie po stronie serwera - nigdy przez NEXT_PUBLIC_*.
KSEF_TOKEN=""

# --- Harmonogram ---
# Sekret chroniący endpoint wyzwalany przez cron. Wygeneruj: openssl rand -hex 32
CRON_SECRET=""
